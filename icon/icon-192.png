<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Arka plan -->
  <rect width="512" height="512" rx="96" fill="#4A90E2"/>
  
  <!-- Not defteri gövdesi -->
  <rect x="120" y="100" width="240" height="320" rx="16" fill="#FFFFFF" stroke="#2C3E50" stroke-width="10"/>
  
  <!-- Spiraller (sol taraf) -->
  <g fill="none" stroke="#2C3E50" stroke-width="10" stroke-linecap="round">
    <line x1="120" y1="150" x2="90" y2="150"/>
    <line x1="120" y1="200" x2="90" y2="200"/>
    <line x1="120" y1="250" x2="90" y2="250"/>
    <line x1="120" y1="300" x2="90" y2="300"/>
    <line x1="120" y1="350" x2="90" y2="350"/>
  </g>
  
  <!-- Defter çizgileri -->
  <g stroke="#BDC3C7" stroke-width="6" stroke-linecap="round">
    <line x1="160" y1="180" x2="330" y2="180"/>
    <line x1="160" y1="230" x2="330" y2="230"/>
    <line x1="160" y1="280" x2="330" y2="280"/>
    <line x1="160" y1="330" x2="280" y2="330"/>
  </g>
  
  <!-- Kalem -->
  <g transform="rotate(35 350 350)">
    <rect x="330" y="120" width="40" height="280" fill="#F5A623" stroke="#2C3E50" stroke-width="8"/>
    <polygon points="330,400 370,400 350,450" fill="#E8D5B7" stroke="#2C3E50" stroke-width="8" stroke-linejoin="round"/>
    <polygon points="345,435 355,435 350,450" fill="#2C3E50"/>
    <rect x="330" y="120" width="40" height="30" fill="#E74C3C" stroke="#2C3E50" stroke-width="8"/>
  </g>
</svg>