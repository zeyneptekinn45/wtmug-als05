<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="skyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2196f3"/>
      <stop offset="50%" stop-color="#42a5f5"/>
      <stop offset="100%" stop-color="#667eea"/>
    </linearGradient>
    <linearGradient id="sunGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffeb3b"/>
      <stop offset="100%" stop-color="#ff9800"/>
    </linearGradient>
    <linearGradient id="cloudGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#e3f2fd"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="6"/>
      <feOffset dx="0" dy="4" result="offsetblur"/>
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.25"/>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Arka plan -->
  <rect width="512" height="512" rx="96" ry="96" fill="url(#skyGrad)"/>

  <!-- Güneş -->
  <g filter="url(#shadow)">
    <circle cx="340" cy="180" r="72" fill="url(#sunGrad)"/>
    <!-- Güneş ışınları -->
    <g stroke="#ffeb3b" stroke-width="10" stroke-linecap="round" opacity="0.85">
      <line x1="340" y1="70"  x2="340" y2="48"/>
      <line x1="340" y1="290" x2="340" y2="312"/>
      <line x1="230" y1="180" x2="208" y2="180"/>
      <line x1="450" y1="180" x2="472" y2="180"/>
      <line x1="262" y1="102" x2="246" y2="86"/>
      <line x1="418" y1="258" x2="434" y2="274"/>
      <line x1="418" y1="102" x2="434" y2="86"/>
      <line x1="262" y1="258" x2="246" y2="274"/>
    </g>
  </g>

  <!-- Bulut (ön planda) -->
  <g filter="url(#shadow)">
    <path fill="url(#cloudGrad)"
          d="M140 340
             a56 56 0 0 1 56 -56
             a72 72 0 0 1 138 -18
             a52 52 0 0 1 78 46
             a44 44 0 0 1 -8 86
             l-224 0
             a44 44 0 0 1 -40 -58 z"/>
  </g>
</svg>